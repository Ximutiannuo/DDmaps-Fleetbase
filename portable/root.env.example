DDMAPS_DB_APP_PASSWORD=__APP_PASSWORD__
DDMAPS_SOCKET_AUTH_KEY=__SOCKET_KEY__
CONSOLE_HOST=https://localhost:4200
SESSION_DOMAIN=localhost
