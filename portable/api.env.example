APP_NAME=DDmaps
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://localhost:4200
LOG_CHANNEL=daily
LOG_LEVEL=warning
HTTP_CLIENT_TRACE_ENABLED=false
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fleetbase
DB_USERNAME=ddmaps_app
# DATABASE_URL and its password are injected by compose.portable.yml.
BROADCAST_DRIVER=socketcluster
CACHE_DRIVER=redis
CACHE_URL=tcp://cache
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SOCKETCLUSTER_HOST=socket
SOCKETCLUSTER_PORT=8000
CONSOLE_HOST=https://localhost:4200
OSRM_HOST=https://router.project-osrm.org
# Set the company for driver self-registration after creating it. The gate is optional.
CONSTRUCTION_SITE_DEFAULT_GATE_UUID=
CONSTRUCTION_SITE_DEFAULT_COMPANY_UUID=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=DDmaps
