<div class="relative">
    <button type="button" aria-label="工地通知" aria-expanded={{this.showPanel}} {{on "click" this.togglePanel}} class="relative p-2 rounded-full hover:bg-gray-100">
        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        {{#if this.unreadCount}}
            <span class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-red-500 rounded-full">{{this.unreadCount}}</span>
        {{/if}}
    </button>

    {{#if this.showPanel}}
        <div class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl z-50 border border-gray-200">
            <div class="p-3 border-b font-bold text-sm">最新通知</div>
            <div class="max-h-64 overflow-y-auto">
                {{#each this.recentNotifications as |n|}}
                    <div class="p-3 border-b hover:bg-gray-50">
                        <p class="font-medium text-sm">{{n.title}}</p>
                        <p class="text-xs text-gray-500 mt-1">{{n.message}}</p>
                        <span class="text-xs px-1.5 py-0.5 rounded mt-1 inline-block
                            {{if (eq n.severity 'critical') 'bg-red-100 text-red-700'}}
                            {{if (eq n.severity 'warning') 'bg-yellow-100 text-yellow-700'}}
                            {{if (eq n.severity 'info') 'bg-blue-100 text-blue-700'}}">
                            {{n.severity}}
                        </span>
                    </div>
                {{else}}
                    <div class="p-4 text-center text-gray-400 text-sm">暂无新通知</div>
                {{/each}}
            </div>
            <button type="button" {{on "click" this.markAllRead}} class="block w-full p-3 text-center text-sm text-blue-600 hover:bg-gray-50">全部已读</button>
            <p role="status" class="px-3 pb-2 text-sm text-gray-600">{{this.error}}</p>
        </div>
    {{/if}}
</div>
