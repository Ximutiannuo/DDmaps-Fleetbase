<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">进场车辆</h1>
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">车辆</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">类别</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">载重</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">所属单位</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                {{#each @model as |meta|}}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm font-medium">{{meta.vehicle.name}}</td>
                        <td class="px-4 py-3 text-sm">{{meta.vehicle_category}}</td>
                        <td class="px-4 py-3 text-sm">{{meta.capacity}}</td>
                        <td class="px-4 py-3 text-sm">{{meta.belonging_unit}}</td>
                    </tr>
                {{else}}
                    <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">暂无车辆数据</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
