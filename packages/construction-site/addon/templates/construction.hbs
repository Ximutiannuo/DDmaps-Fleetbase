<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">施工活动</h1>
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">标题</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">类型</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">开始时间</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">结束时间</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">影响路段</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                {{#each @model as |activity|}}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm font-medium">{{activity.title}}</td>
                        <td class="px-4 py-3 text-sm">{{activity.type}}</td>
                        <td class="px-4 py-3">
                            <span class="text-xs px-2 py-1 rounded
                                {{if (eq activity.status 'active') 'bg-blue-100 text-blue-700'}}
                                {{if (eq activity.status 'planned') 'bg-gray-100 text-gray-700'}}
                                {{if (eq activity.status 'completed') 'bg-green-100 text-green-700'}}
                                {{if (eq activity.status 'paused') 'bg-yellow-100 text-yellow-700'}}">
                                {{activity.status}}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-500">{{activity.starts_at}}</td>
                        <td class="px-4 py-3 text-sm text-gray-500">{{activity.ends_at}}</td>
                        <td class="px-4 py-3 text-sm">{{activity.roadSegments.length}}</td>
                    </tr>
                {{else}}
                    <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">暂无施工活动</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
