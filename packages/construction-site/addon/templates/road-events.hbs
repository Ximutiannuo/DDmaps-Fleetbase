<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">道路事件</h1>
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">标题</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">类型</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">路段</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">开始时间</th>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                {{#each @model as |event|}}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm font-medium">{{event.title}}</td>
                        <td class="px-4 py-3 text-sm">{{event.event_type}}</td>
                        <td class="px-4 py-3 text-sm">{{event.segment.name}}</td>
                        <td class="px-4 py-3 text-sm text-gray-500">{{event.starts_at}}</td>
                        <td class="px-4 py-3">
                            {{#if event.isActive}}
                                <span class="text-xs px-2 py-1 rounded bg-orange-100 text-orange-700">活跃</span>
                            {{else}}
                                <span class="text-xs px-2 py-1 rounded bg-green-100 text-green-700">已解除</span>
                            {{/if}}
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">暂无道路事件</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
