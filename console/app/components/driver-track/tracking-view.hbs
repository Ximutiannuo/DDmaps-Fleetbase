<div class="relative w-full h-screen">
    {{!-- Leaflet map container --}}
    <div
        {{did-insert this.setupMap}}
        {{did-update this.updateMarkerFromPosition this.position}}
        class="absolute inset-0 z-0"
        style="width:100%;height:100%;"
    ></div>

    {{!-- Error overlay --}}
    {{#if this.error}}
        <div class="absolute top-0 left-0 right-0 z-20 bg-red-600 text-white p-3 text-sm text-center">
            {{this.error}}
        </div>
    {{/if}}

    {{!-- Waiting for position overlay --}}
    {{#if (and (not this.position) (not this.error))}}
        <div class="absolute inset-0 z-10 flex items-center justify-center bg-gray-800 bg-opacity-50">
            <div class="text-center text-white">
                <div class="animate-spin inline-block w-8 h-8 border-4 border-white border-t-transparent rounded-full mb-3"></div>
                <p class="text-sm">正在获取定位...</p>
                <p class="text-xs mt-1 opacity-75">请允许浏览器获取您的位置</p>
            </div>
        </div>
    {{/if}}

    {{!-- Status bar overlay --}}
    {{#unless this.position}}
        <div class="absolute bottom-4 left-4 right-4 z-20 rounded bg-white p-4 shadow">
            <p class="text-sm text-gray-700">定位尚未就绪，登记会话仍保留。</p>
            <div class="flex gap-3 mt-3">
                <button type="button" {{on "click" this.retryLocation}} class="rounded bg-blue-600 text-white px-4 py-2">重试定位</button>
                <button type="button" {{on "click" this.confirmExit}} class="rounded bg-red-600 text-white px-4 py-2">退场</button>
            </div>
        </div>
    {{/unless}}
    {{#if this.position}}
        <div class="absolute top-0 left-0 right-0 z-10 bg-white bg-opacity-90 shadow p-3">
            <div class="flex items-center justify-between mb-1">
                <div class="text-sm">
                    {{#if (eq this.mode 'navigating')}}
                        <span class="font-medium text-blue-600">导航中</span>
                        {{#if this.showRecalcNotice}}
                            <span class="ml-2 text-xs text-orange-500">正在重新规划路线...</span>
                        {{/if}}
                    {{else}}
                        <span class="font-medium text-gray-800">追踪中</span>
                    {{/if}}
                    <span class="ml-2 text-xs text-gray-400">本机定位 #{{this.updateCount}}</span>
                    {{#if this.lastUpdateLabel}}
                        <span class="ml-2 text-xs text-gray-400">{{this.lastUpdateLabel}}</span>
                    {{/if}}
                </div>
                {{#if (eq this.mode 'tracking')}}
                    <button type="button" {{on "click" this.confirmExit}} class="bg-red-600 text-white text-sm rounded px-4 py-1.5 font-medium hover:bg-red-700">
                        退场
                    </button>
                {{/if}}
            </div>
            {{#if this.accuracyLabel}}
                <div class="text-xs {{if this.accuracyGood 'text-green-600' 'text-orange-600'}}">
                    {{this.accuracyLabel}}
                </div>
            {{/if}}
            {{#if this.coordsLabel}}
                <div class="text-xs text-gray-400 mt-0.5 font-mono">{{this.coordsLabel}}</div>
            {{/if}}
            <div class="text-xs mt-1 {{if this.gpsUploadWarning 'text-orange-700' 'text-green-700'}}">
                {{this.gpsUploadLabel}} · 上次确认 {{this.lastUploadLabel}}
            </div>
            <div class="text-xs text-gray-500">{{this.positionFreshnessLabel}}</div>
            {{#if (eq this.gpsUploadState 'expired')}}
                <button type="button" {{on "click" this.registerAgain}} class="text-sm text-blue-700 underline">重新登记</button>
            {{/if}}
            <div class="text-xs text-gray-700 mt-1">{{this.trafficSummary}} · {{this.trafficUpdatedAt}}</div>
            <div class="text-xs text-gray-600">灰：数据不足 · 绿：通畅 · 黄／橙：减速或拥堵 · 红：封闭或严重拥堵 · 圆点：交汇点</div>
            {{#if (eq this.mode 'navigating')}}<div class="text-xs text-blue-700">按预计通行时间规划，路况变化后自动重规划</div>{{/if}}
        </div>
    {{/if}}

    {{!-- Service area hint when tracking --}}
    {{#if (and this.position (eq this.mode 'tracking'))}}
        <div class="absolute bottom-36 left-0 right-0 z-10 text-center pointer-events-none">
            <span class="bg-blue-600 text-white text-xs rounded-full px-3 py-1 inline-block shadow">
                点击地图上的区域开始导航
            </span>
        </div>
    {{/if}}

    {{!-- Recenter button --}}
    {{#if this.position}}
        <button type="button" {{on "click" this.recenter}}
            class="absolute bottom-20 right-4 z-10 bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center hover:bg-gray-100"
            title="回到我的位置">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="3"/>
                <line x1="12" y1="2" x2="12" y2="4"/>
                <line x1="12" y1="20" x2="12" y2="22"/>
                <line x1="2" y1="12" x2="4" y2="12"/>
                <line x1="20" y1="12" x2="22" y2="12"/>
            </svg>
        </button>
    {{/if}}

    {{!-- Navigation panel (when navigating) --}}
    {{#if (and (eq this.mode 'navigating') this.currentRoute)}}
        <DriverTrack::NavigationPanel
            @route={{this.currentRoute}}
            @stepIndex={{this.navStepIndex}}
            @stepRemainingDistance={{this.navStepRemainingDistance}}
            @traveledDistance={{this.navTraveledDistance}}
            @remainingDistance={{this.navRemainingDistance}}
            @remainingDuration={{this.navRemainingDuration}}
            @onCancel={{this.stopNavigation}}
        />
    {{/if}}

    {{!-- Route calculating overlay --}}
    {{#if (and (eq this.mode 'navigating') this.isCalculatingRoute (not this.currentRoute))}}
        <div class="absolute inset-0 z-20 flex items-center justify-center bg-black bg-opacity-30">
            <div class="bg-white rounded-lg p-6 text-center">
                <div class="animate-spin inline-block w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full mb-3"></div>
                <p class="text-sm text-gray-700">正在计算路线...</p>
            </div>
        </div>
    {{/if}}

    {{!-- Exit confirmation modal --}}
    {{#if this.showExitConfirm}}
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded p-6 max-w-sm mx-4">
                <h3 class="text-lg font-bold mb-2">确认退场？</h3>
                <p class="text-gray-600 mb-4 text-sm">退场后将停止 GPS 追踪</p>
                <div class="flex gap-3">
                    <button type="button" {{on "click" this.cancelExit}} class="flex-1 border rounded p-2">取消</button>
                    <button type="button" {{on "click" this.doExit}} class="flex-1 bg-red-600 text-white rounded p-2">确认退场</button>
                </div>
            </div>
        </div>
    {{/if}}
</div>
